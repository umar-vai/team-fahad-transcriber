# Shared pool used by both transcription and AI client tools.
# Put your real keys in Streamlit Cloud > App > Settings > Secrets.
# Never commit real keys to GitHub.
GEMINI_API_KEYS = [
  "paste-primary-key-here",
  "paste-backup-key-here"
]

# Optional: use separate pools for transcription and AI client tools.
# If these are present, they override the shared pool for that feature group.
# TRANSCRIBE_GEMINI_API_KEYS = [
#   "paste-transcription-primary-key-here",
#   "paste-transcription-backup-key-here"
# ]
#
# CONTENT_GEMINI_API_KEYS = [
#   "paste-content-primary-key-here",
#   "paste-content-backup-key-here"
# ]

# Backward-compatible single-key option:
# GEMINI_API_KEY = "paste-one-key-here"

# Google service account used by the Batch Transcription page.
# Create one in Google Cloud, enable Google Drive API + Google Sheets API,
# download its JSON key, then copy the matching values below.
# IMPORTANT: share BOTH the project tracker Sheet and the raw-video Drive folder
# with the service account's client_email as Editor/Viewer as appropriate.
# Never commit a real private key to GitHub.
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "your-private-key-id"
# private_key = """-----BEGIN PRIVATE KEY-----
# paste-private-key-here
# -----END PRIVATE KEY-----
# """
# client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
# client_id = "123456789012345678901"
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
# universe_domain = "googleapis.com"

# Alternative: provide the whole service-account JSON as one environment variable.
# GOOGLE_SERVICE_ACCOUNT_JSON = '''{"type":"service_account", ... }'''

# Optional private preview lock:
# APP_ACCESS_CODE = "your-private-access-code"

# Optional: enables next.frame.io/share/.../view/... links through the official Frame.io V4 API.
# Create an access token in Frame.io/Adobe developer settings and paste it only in Streamlit Secrets.
# FRAMEIO_ACCESS_TOKEN = "paste-frameio-access-token-here"

# Frame.io / Adobe OAuth Web App credentials.
# FRAMEIO_CLIENT_ID = "your-adobe-client-id"
# FRAMEIO_CLIENT_SECRET = "your-adobe-client-secret"
# FRAMEIO_REDIRECT_URI = "https://your-app.streamlit.app/"
