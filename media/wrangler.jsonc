{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-fahad-transcriber-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MediaContainer",
      "image": "./container/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 20
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MEDIA_CONTAINER", "class_name": "MediaContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MediaContainer"] }]
}
