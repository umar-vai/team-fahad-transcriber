---
import Base from "../layouts/Base.astro";
import Results from "../components/Results.astro";
import Icon from "../components/Icon.astro";
import Landing from "../components/public/Landing.astro";
import { apiKeys, LANGUAGES } from "../lib/gemini";

// Not signed in: the public home page. Signed in: the transcriber.
const signedIn = Boolean(Astro.locals.user);
const connected = apiKeys().length > 0;
const firstName = (Astro.locals.user?.name || "").split(" ")[0];
---
{!signedIn ? <Landing /> : (
<Base title="Transcribe · TEAMCRIBER">
  <div class="page-head">
    <div>
      <h1>{firstName ? `Welcome back, ${firstName}` : "Transcribe"}</h1>
      <p>Turn audio and video into accurate text with speakers, subtitles, summaries and translations.</p>
    </div>
    <div class="actions">
      <span class:list={["pill", connected ? "good" : "bad"]}>{connected ? "Transcription engine ready" : "Gemini key missing"}</span>
    </div>
  </div>

  <div class="stack loose">
    <section class="card flush">
      <div class="card-head">
        <div class="segmented" role="tablist" id="source-tabs" aria-label="Source">
          <button role="tab" aria-selected="true" data-source="upload" type="button"><Icon name="upload" />Upload files</button>
          <button role="tab" aria-selected="false" data-source="link" type="button"><Icon name="link" />Paste links</button>
          <button role="tab" aria-selected="false" data-source="folder" type="button"><Icon name="folder" />Drive folder</button>
          <button role="tab" aria-selected="false" data-source="live" type="button"><Icon name="mic" />Live voice</button>
        </div>
      </div>

      <div class="card-body stack">
        <div class="grid-3">
          <label>Language
            <select id="language">
              {Object.keys(LANGUAGES).map((name) => <option value={name} selected={name === "Bangla (Bangladesh)"}>{name}</option>)}
            </select>
          </label>
          <label>Output style
            <select id="mode">
              <option value="smart">Smart clean transcript</option>
              <option value="detailed">Subtitles with speakers (timed)</option>
              <option value="verbatim">Exact verbatim transcript</option>
              <option value="shayari">Shayari (Urdu/Hindi in Bangla and English letters)</option>
            </select>
          </label>
          <label>Names and terms <span class="hint">optional</span>
            <input type="text" id="vocab" placeholder="e.g. Team Fahad, Umar Vai" />
          </label>
        </div>
        <p class="notice info small-text hidden" id="shayari-hint">
          <Icon name="info" /><span>শায়েরি মোড: উর্দু বা হিন্দি শায়েরির লিঙ্ক বা ফাইল দিন। রেজাল্টে তিনটা অংশ আসবে: বাংলা অক্ষরে উচ্চারণ, ইংলিশ অক্ষরে উচ্চারণ, আর বাংলা অনুবাদ। এই মোডে Language সেটিং লাগে না।</span>
        </p>

        <div data-source-panel="upload" class="stack">
          <label class="dropzone" id="dropzone">
            <input type="file" id="file" multiple accept="audio/*,video/*,.mkv,.mov,.m4a,.aac,.flac,.ogg,.opus,.wma,.webm" hidden />
            <span class="dz-icon"><Icon name="upload" size="lg" /></span>
            <strong id="file-label">Drop audio or video files here, or click to choose</strong>
            <span class="muted small-text">MP3, WAV, M4A, MP4, MOV, MKV and more. You can pick many: they run one after another, long files are split and run in parallel.</span>
          </label>
          <button class="btn block lg" id="upload-go" type="button" disabled><Icon name="play" />Transcribe files</button>
        </div>

        <div data-source-panel="link" class="stack hidden">
          <label>Media links <span class="hint">one per line</span>
            <textarea id="link" rows="5" placeholder="YouTube, Google Drive, Facebook, Frame.io or a direct media link"></textarea>
          </label>
          <p class="muted small-text">Public links only. For a whole Google Drive folder, use the Drive folder tab.</p>
          <button class="btn block lg" id="link-go" type="button"><Icon name="play" />Transcribe links</button>
        </div>

        <div data-source-panel="folder" class="stack hidden">
          <label>Google Drive folder link
            <input type="url" id="folder-link" placeholder="https://drive.google.com/drive/folders/..." />
          </label>
          <fieldset class="choice">
            <legend>Output style</legend>
            <label><input type="radio" name="folder-mode" value="smart" checked /> <span><strong>Smart clean</strong><small class="muted">Clean paragraphs, easy to read</small></span></label>
            <label><input type="radio" name="folder-mode" value="detailed" /> <span><strong>Subtitles (timed)</strong><small class="muted">Time stamps and speakers on every line</small></span></label>
          </fieldset>
          <p class="notice small-text">
            <Icon name="info" />
            <span>Share the folder as "Anyone with the link". Every video and audio file in it (and its subfolders) is transcribed on the server, so you can close this page. Each finished file is saved to your History, and to Notion and Google Sheets when they are set up.</span>
          </p>
          <button class="btn block lg" id="folder-go" type="button"><Icon name="folder" />Transcribe whole folder</button>
        </div>

        <div data-source-panel="live" class="stack hidden">
          <p class="muted small-text">Speak into your microphone. Text appears every few seconds, after each short pause. Speaker labels are not available in live mode.</p>
          <div class="row">
            <button class="btn" id="live-go" type="button"><Icon name="mic" />Start recording</button>
            <span id="live-state" class="muted"></span>
          </div>
          <div class="progress"><div id="live-level"></div></div>
          <div class="transcript hidden" id="live-text"></div>
        </div>
      </div>
    </section>

    <section class="card stack hidden" id="queue-card">
      <div class="section-head" style="margin:0">
        <div>
          <h2>Queue</h2>
          <p id="queue-summary"></p>
        </div>
        <div class="row">
          <button class="btn small hidden" id="queue-zip" type="button"><Icon name="download" />Download all (ZIP)</button>
          <button class="btn ghost small hidden" id="queue-clear" type="button">Clear finished</button>
        </div>
      </div>
      <div class="queue" id="queue-list"></div>
    </section>
    <div class="notice error hidden" id="error-box" role="alert"></div>

    <Results />
  </div>
</Base>
)}

<script>
  // The landing page has no transcriber on it, so its code is only loaded for signed-in people.
  if (document.getElementById("source-tabs")) import("../scripts/transcriber").then((m) => m.initTranscriber());
</script>
