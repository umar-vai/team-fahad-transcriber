---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { env } from "cloudflare:workers";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/batches");
// Personal folders only. Nightly team jobs are on the team's Automation page.
const { results } = await env.DB.prepare(
  `SELECT id, folder_name, mode, total, done_count, failed_count, status, notion_url, sheet_url, created_at
     FROM batches WHERE user_id = ? AND workspace_id IS NULL ORDER BY created_at DESC LIMIT 100`,
).bind(user.id).all<any>();
const modeLabel: Record<string, string> = { smart: "Smart clean", detailed: "Subtitles" };
---
<Base title="Drive folders · TEAMCRIBER">
  <div class="page-head">
    <div>
      <h1>Drive folders</h1>
      <p>Whole Google Drive folders you sent for transcription. They run on the server, so you can close the page.</p>
    </div>
    <div class="actions"><a class="btn" href="/#folder"><Icon name="plus" />New folder</a></div>
  </div>
  <section class="card flush">
    {results.length === 0 ? (
      <div class="empty">
        <span class="empty-icon"><Icon name="folder" size="lg" /></span>
        <h3>No folders yet</h3>
        <p>Paste a shared Google Drive folder link and every video and audio file inside is transcribed for you.</p>
        <a class="btn small" href="/#folder"><Icon name="plus" />Transcribe a folder</a>
      </div>
    ) : (
      <div class="list">
        {results.map((b) => {
          const pct = b.total ? Math.round(((b.done_count + b.failed_count) / b.total) * 100) : 0;
          return (
            <a class="list-item" href={`/batches/${b.id}`}>
              <span class="li-icon"><Icon name="folder" /></span>
              <span class="li-main">
                <span class="li-title">{b.folder_name}</span>
                <span class="li-sub">{b.status === "running" ? `${b.total} files, working` : `${b.done_count} of ${b.total} done${b.failed_count ? `, ${b.failed_count} failed` : ""}`}</span>
                {b.status === "running" && <span class="progress" style="max-width:280px"><span style={`display:block;height:100%;width:${pct}%;background:var(--accent)`}></span></span>}
              </span>
              <span class="li-meta">
                <span class:list={["pill", b.status === "running" ? "work" : b.status === "done" ? (b.failed_count ? "warn" : "good") : ""]}>
                  {b.status === "running" ? "Running" : b.status === "done" ? (b.failed_count ? "Finished with errors" : "Finished") : "Stopped"}
                </span>
                <span class="chip">{modeLabel[b.mode] || b.mode}</span>
                <span data-time={b.created_at}>{new Date(b.created_at).toISOString().slice(0, 10)}</span>
              </span>
            </a>
          );
        })}
      </div>
    )}
  </section>
</Base>
<script>
  const fmt = new Intl.DateTimeFormat(undefined, { day: "numeric", month: "short", year: "numeric" });
  document.querySelectorAll<HTMLElement>("[data-time]").forEach((el) => (el.textContent = fmt.format(new Date(Number(el.dataset.time)))));
</script>
