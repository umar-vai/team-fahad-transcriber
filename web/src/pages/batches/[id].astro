---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";

const user = Astro.locals.user;
const id = Astro.params.id || "";
if (!user) return Astro.redirect(`/login?next=/batches/${encodeURIComponent(id)}`);
---
<Base title="Folder · TEAMCRIBER">
  <div class="stack" id="batch" data-id={id}>
    <div>
      <a class="back" href="/batches" id="b-back"><Icon name="back" size="sm" />All folders</a>
      <div class="page-head" style="margin:0">
        <div style="min-width:0">
          <h1 id="b-title">Loading…</h1>
          <div class="chips" id="b-chips" style="margin-top:8px"></div>
        </div>
        <div class="actions">
          <button class="btn ghost small hidden" id="b-stop" type="button">Stop</button>
          <button class="btn small hidden" id="b-resume" type="button"><Icon name="refresh" />Retry failed</button>
          <button class="btn ghost small hidden" id="b-zip" type="button"><Icon name="download" />Download all (ZIP)</button>
        </div>
      </div>
    </div>

    <section class="card stack">
      <div class="batch-stats">
        <div class="stat good"><span>Done</span><strong id="s-done">0</strong></div>
        <div class="stat"><span>Left</span><strong id="s-left">0</strong></div>
        <div class="stat bad"><span>Failed</span><strong id="s-failed">0</strong></div>
        <div class="stat"><span>Files</span><strong id="s-total">0</strong></div>
      </div>
      <div class="progress"><div id="b-bar"></div></div>
      <div class="links" id="b-links"></div>
      <p class="muted small-text" id="b-note">This runs on the server. You can close this page and come back any time.</p>
    </section>

    <div class="notice error hidden" id="b-error" role="alert"></div>
    <section class="queue" id="b-items"></section>
  </div>
</Base>

<script>
  import { initBatchPage } from "../../scripts/batch";
  initBatchPage();
</script>
