---
import Base from "../../layouts/Base.astro";

const user = Astro.locals.user;
const id = Astro.params.id || "";
if (!user) return Astro.redirect(`/login?next=/batches/${encodeURIComponent(id)}`);
---
<Base title="Folder · Team Fahad Transcriber">
  <div class="stack" id="batch" data-id={id}>
    <div class="page-head" style="margin:0">
      <div style="min-width:0">
        <p class="muted small-text" style="margin:0"><a href="/batches">← All folders</a></p>
        <h1 id="b-title">Loading…</h1>
        <div class="chips" id="b-chips"></div>
      </div>
      <div class="row">
        <button class="btn ghost small hidden" id="b-stop" type="button">Stop</button>
        <button class="btn small hidden" id="b-resume" type="button">Retry failed</button>
        <button class="btn small hidden" id="b-zip" type="button">Download all (ZIP)</button>
      </div>
    </div>

    <section class="card stack">
      <div class="batch-stats">
        <div class="stat"><strong id="s-done">0</strong><span>Done</span></div>
        <div class="stat"><strong id="s-left">0</strong><span>Left</span></div>
        <div class="stat"><strong id="s-failed">0</strong><span>Failed</span></div>
        <div class="stat"><strong id="s-total">0</strong><span>Videos</span></div>
      </div>
      <div class="progress"><div id="b-bar"></div></div>
      <div class="links" id="b-links"></div>
      <p class="muted small-text" id="b-note" style="margin:0">This runs on the server. You can close this page and come back any time.</p>
    </section>

    <div class="notice error hidden" id="b-error" role="alert"></div>
    <section class="queue" id="b-items"></section>
  </div>
</Base>

<script>
  import { initBatchPage } from "../../scripts/batch";
  initBatchPage();
</script>
