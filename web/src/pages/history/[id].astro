---
import Base from "../../layouts/Base.astro";
import Results from "../../components/Results.astro";
import Icon from "../../components/Icon.astro";
import { transcriptAccess } from "../../lib/workspaces";
import { SOURCE_LABEL } from "../../lib/labels";
import { fixDriveTitles } from "../../lib/drivename";

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const found = await transcriptAccess(user, String(Astro.params.id || ""));
if (!found) return new Response("Not found", { status: 404 });
const { row, canEdit, workspace } = found;
await fixDriveTitles([row]).catch(() => undefined);
const segments = JSON.parse(row.segments_json || "[]");
const result = {
  title: row.title,
  sourceType: row.source_type,
  sourceRef: row.source_ref,
  mode: row.mode,
  language: row.language,
  duration: row.duration,
  transcript: row.transcript,
  segments,
  estimatedTimes: row.mode !== "detailed",
  historyId: row.id,
  extras: JSON.parse(row.extras_json || "{}"),
};
const isUrl = typeof row.source_ref === "string" && /^https?:\/\//.test(row.source_ref);
const backHref = workspace ? `/auto?team=${encodeURIComponent(workspace.id)}&tab=transcripts` : "/history";
const backLabel = workspace ? `${workspace.name} transcripts` : "History";
---
<Base title={`${row.title} · TEAMCRIBER`}>
  <a class="back" href={backHref}><Icon name="back" size="sm" />{backLabel}</a>
  <div class="page-head">
    <div>
      {workspace && <div class="eyebrow"><Icon name="users" size="sm" />{workspace.name}</div>}
      <p class="small-text" style="margin:0">
        {SOURCE_LABEL[row.source_type] || row.source_type} ·
        {isUrl ? <a href={row.source_ref} rel="noopener noreferrer" target="_blank">{row.source_ref}</a> : (row.source_ref || "")}
        · <span data-time={row.created_at}></span>
      </p>
    </div>
    {canEdit && (
      <div class="actions">
        <button class="btn ghost small" id="rename" type="button">Rename</button>
        <button class="btn danger small" id="delete" type="button"><Icon name="trash" />Delete</button>
      </div>
    )}
  </div>
  <Results />
  <script type="application/json" id="result-data" set:html={JSON.stringify({ ...result, back: backHref }).replace(/</g, "\\u003c")}></script>
</Base>
<script>
  import { initResults, showResult } from "../../scripts/results";
  const data = JSON.parse(document.getElementById("result-data")!.textContent || "{}");
  initResults();
  showResult(data);
  document.getElementById("history-link")?.classList.add("hidden");
  const fmt = new Intl.DateTimeFormat(undefined, { day: "numeric", month: "short", year: "numeric", hour: "numeric", minute: "2-digit" });
  document.querySelectorAll<HTMLElement>("[data-time]").forEach((el) => (el.textContent = fmt.format(new Date(Number(el.dataset.time)))));
  document.getElementById("delete")?.addEventListener("click", async () => {
    if (!confirm("Delete this transcript? This cannot be undone.")) return;
    const response = await fetch(`/api/history/${data.historyId}`, { method: "DELETE" });
    if (!response.ok) return (window as any).toast?.("Could not delete it.", "error");
    location.href = data.back;
  });
  document.getElementById("rename")?.addEventListener("click", async () => {
    const title = prompt("New title", data.title);
    if (!title || !title.trim()) return;
    const response = await fetch(`/api/history/${data.historyId}`, { method: "PATCH", headers: { "content-type": "application/json" }, body: JSON.stringify({ title }) });
    if (!response.ok) return (window as any).toast?.("Could not rename it.", "error");
    location.reload();
  });
</script>
