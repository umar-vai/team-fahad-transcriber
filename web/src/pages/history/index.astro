---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { env } from "cloudflare:workers";
import { fixDriveTitles } from "../../lib/drivename";
import { lengthLabel, MODE_LABEL, SOURCE_ICON, SOURCE_LABEL } from "../../lib/labels";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/history");
const q = (Astro.url.searchParams.get("q") || "").trim();
const like = `%${q.replace(/[%_]/g, "")}%`;
// Personal transcripts only. Team transcripts (Automation) live on the team's page.
const { results } = await env.DB.prepare(
  `SELECT id, title, source_type, source_ref, mode, language, duration, created_at, substr(transcript, 1, 180) AS preview
     FROM transcriptions WHERE user_id = ? AND workspace_id IS NULL AND (? = '' OR title LIKE ? OR transcript LIKE ?)
    ORDER BY created_at DESC LIMIT 200`,
).bind(user.id, q, like, like).all<any>();
// Old Drive link transcripts were saved as "google_drive_media": show (and save) the file's real name.
await fixDriveTitles(results).catch((error) => console.warn("Drive titles", error));
---
<Base title="History · TEAMCRIBER">
  <div class="page-head">
    <div>
      <h1>History</h1>
      <p>Everything you transcribed yourself. Only you can see these.</p>
    </div>
    <form method="get" class="search" style="width:min(340px,100%)">
      <Icon name="search" />
      <input type="search" name="q" value={q} placeholder="Search file names and text" aria-label="Search history" />
    </form>
  </div>
  <section class="card flush">
    {results.length === 0 ? (
      <div class="empty">
        <span class="empty-icon"><Icon name={q ? "search" : "history"} size="lg" /></span>
        <h3>{q ? "Nothing matches your search" : "No transcripts yet"}</h3>
        <p>{q ? "Try other words, or clear the search." : "Files, links and live recordings you transcribe are saved here automatically."}</p>
        {q ? <a class="btn ghost small" href="/history">Clear search</a> : <a class="btn small" href="/"><Icon name="plus" />Transcribe something</a>}
      </div>
    ) : (
      <div class="list">
        {results.map((item) => (
          <a class="list-item" href={`/history/${item.id}`}>
            <span class="li-icon"><Icon name={SOURCE_ICON[item.source_type] || "file"} /></span>
            <span class="li-main">
              <span class="li-title">{item.title}</span>
              <span class="li-sub">{item.preview}</span>
            </span>
            <span class="li-meta">
              <span class="chip">{SOURCE_LABEL[item.source_type] || item.source_type}</span>
              <span class="chip">{MODE_LABEL[item.mode] || item.mode}</span>
              {item.duration ? <span class="num">{lengthLabel(item.duration)}</span> : null}
              <span data-time={item.created_at}>{new Date(item.created_at).toISOString().slice(0, 10)}</span>
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
  {results.length === 200 && <p class="muted small-text" style="margin-top:12px">Showing the latest 200. Search to find older ones.</p>}
</Base>
<script>
  const fmt = new Intl.DateTimeFormat(undefined, { day: "numeric", month: "short", year: "numeric", hour: "numeric", minute: "2-digit" });
  document.querySelectorAll<HTMLElement>("[data-time]").forEach((el) => (el.textContent = fmt.format(new Date(Number(el.dataset.time)))));
</script>
