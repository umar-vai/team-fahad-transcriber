---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { devLoginEnabled, googleConfigured } from "../lib/auth";

const next = Astro.url.searchParams.get("next") || "/";
if (Astro.locals.user) return Astro.redirect(next.startsWith("/") && !next.startsWith("//") ? next : "/");
const error = Astro.url.searchParams.get("error");
const setupMissing = error === "setup" || !googleConfigured();
const dev = devLoginEnabled(Astro.url);
---
<Base title="Sign in · TEAMCRIBER" bare>
  <div class="auth">
    <section class="auth-side">
      <a href="/" class="brand" aria-label="TEAMCRIBER home"><Logo size={40} tagline /></a>
      <div>
        <h2>Every recording, turned into clean, searchable text.</h2>
        <p>Bangla and English transcription with speaker subtitles, summaries and translations, plus hands-free automation for whole teams.</p>
        <div class="auth-points">
          <div><Icon name="check" /><span>Bangla, English, Arabic, Hindi and mixed speech</span></div>
          <div><Icon name="check" /><span>Files, links, Google Drive folders and live voice</span></div>
          <div><Icon name="check" /><span>Subtitles with speakers, SRT, VTT and Word exports</span></div>
          <div><Icon name="check" /><span>Team automation from PCs and Drive into Google Sheets</span></div>
        </div>
      </div>
      <p class="small-text" style="margin:0">A product of Magnus Inc. · Developed by Umar Vai</p>
      <svg class="auth-wave" viewBox="0 0 24 24" fill="none" stroke="#4fd1b9" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M4 10v4"/><path d="M8 7v10"/><path d="M12 4v16"/><path d="M16 8v8"/><path d="M20 11v2"/></svg>
    </section>
    <section class="auth-main">
      <div class="auth-card">
        <a class="back" href="/"><Icon name="back" size="sm" />Back to home</a>
        <div>
          <h1>Sign in</h1>
          <p class="sub">Use your Google account. Your transcripts are private to you.</p>
        </div>
        {error && error !== "setup" && <p class="notice error"><Icon name="alert" /><span>{error}</span></p>}
        {setupMissing ? (
          <p class="notice"><Icon name="info" /><span>Google sign-in is not set up yet. The site owner needs to add GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.</span></p>
        ) : (
          <a class="btn block google-btn lg" href={`/auth/google?next=${encodeURIComponent(next)}`}>
            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
            Continue with Google
          </a>
        )}
        {dev && (
          <>
            <div class="divider">Local development</div>
            <form method="post" action="/auth/dev" class="stack tight">
              <input type="hidden" name="next" value={next} />
              <label>Sign in as (no Google, localhost only)
                <input type="email" name="email" required placeholder="name@example.com" />
              </label>
              <button class="btn ghost block" type="submit">Sign in without Google</button>
            </form>
          </>
        )}
        <p class="muted small-text" style="margin:0">By signing in you agree to use this tool only for recordings you are allowed to transcribe.</p>
      </div>
    </section>
  </div>
</Base>
