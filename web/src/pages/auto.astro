---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { LANGUAGES } from "../lib/gemini";
import { BATCH_MODES } from "../batch/runner";
import { accessibleWorkspaces } from "../lib/workspaces";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/login?next=/auto");
const teams = await accessibleWorkspaces(user);
const wanted = Astro.url.searchParams.get("team") || "";
const current = teams.find((t) => t.workspace.id === wanted) || teams[0] || null;
const tabs = current
  ? [
      ...(current.workspace.feature_bridge ? [["bridge", "Bridge PCs", "monitor"]] : []),
      ...(current.workspace.feature_drive ? [["drive", "Google Drive", "cloud"]] : []),
      ["transcripts", "Transcripts", "text"],
    ]
  : [];
const askedTab = Astro.url.searchParams.get("tab") || "";
const tab = tabs.some(([key]) => key === askedTab) ? askedTab : tabs[0]?.[0] || "transcripts";
const boot = current && {
  team: {
    id: current.workspace.id,
    name: current.workspace.name,
    kind: current.workspace.kind,
    canManage: current.canManage,
    role: current.role,
    isDefault: Boolean(current.workspace.is_default),
  },
  tab,
  modes: Object.entries(BATCH_MODES),
  languages: Object.keys(LANGUAGES),
  connected: Boolean(Astro.url.searchParams.get("connected")),
  problem: Astro.url.searchParams.get("error") || "",
};
const roleLabel: Record<string, string> = { admin: "Admin", manager: "Manager", viewer: "Viewer" };
---
<Base title={`${current ? current.workspace.name : "Automation"} · TEAMCRIBER`}>
  {!current ? (
    <section class="card">
      <div class="empty">
        <span class="empty-icon"><Icon name="bolt" size="lg" /></span>
        <h3>Automation is for teams</h3>
        <p>Automatic transcription from team PCs and Google Drive is available to team members. Ask an admin to add your email to a team.</p>
        <a class="btn small" href="/">Go to Transcribe</a>
      </div>
    </section>
  ) : (
    <>
      <div class="team-bar">
        <div class="team-switch">
          <span class="team-avatar">{current.workspace.name.trim()[0]}</span>
          <div class="stack tight" style="gap:4px">
            {teams.length > 1 ? (
              <select id="team-select" aria-label="Choose team">
                {teams.map((t) => <option value={t.workspace.id} selected={t.workspace.id === current.workspace.id}>{t.workspace.name}</option>)}
              </select>
            ) : (
              <h1 style="font-size:20px">{current.workspace.name}</h1>
            )}
            <div class="chips">
              <span class:list={["badge", current.workspace.kind === "customer" ? "info" : "accent"]}>{current.workspace.kind === "customer" ? "Customer" : "Team"}</span>
              <span class="badge">{roleLabel[current.role]}</span>
            </div>
          </div>
        </div>
        {Astro.locals.isAdmin && <a class="btn ghost small" href={`/admin?team=${encodeURIComponent(current.workspace.id)}`}><Icon name="users" />Members and features</a>}
      </div>

      <div class="notice ok hidden" id="flash-ok"><Icon name="check" /><span></span></div>
      <div class="notice error hidden" id="flash-bad"><Icon name="alert" /><span></span></div>

      <nav class="tabs" role="tablist" id="auto-tabs">
        {tabs.map(([key, label, icon]: string[]) => (
          <button role="tab" type="button" data-tab={key} aria-selected={key === tab ? "true" : "false"}><Icon name={icon} />{label}</button>
        ))}
      </nav>

      <!-- Bridge PCs -->
      <section data-panel="bridge" class="stack hidden">
        <div class="section-head" style="margin:0">
          <div>
            <h2>Bridge PCs</h2>
            <p>The Bridge app on each PC transcribes new recordings as soon as they arrive.</p>
          </div>
          <span class="muted small-text" id="bridge-updated"></span>
        </div>
        <div class="stats" id="bridge-stats"></div>
        <div class="pc-grid" id="bridge-pcs"><p class="muted">Loading…</p></div>
        <div class="card flush hidden" id="pc-detail"></div>

        <div class="grid-2 manage-only">
          <section class="card stack">
            <div class="card-title"><span class="icon-box"><Icon name="plus" /></span><div><h3>Add a PC</h3><p class="muted small-text">Get a one-time code, then type it in the Bridge app on that PC.</p></div></div>
            <div class="input-group">
              <label>PC name<input id="bridge-name" type="text" maxlength="60" placeholder="e.g. PC-03" /></label>
              <button class="btn" id="bridge-add" type="button">Get pairing code</button>
            </div>
            <div id="pairing" class="notice hidden"></div>
          </section>
          <section class="card stack">
            <div class="card-title"><span class="icon-box"><Icon name="settings" /></span><div><h3>PC settings</h3><p class="muted small-text">Used by every PC of this team.</p></div></div>
            <div class="grid-2">
              <label>Output style<select id="bridge-mode"></select></label>
              <label>Language<select id="bridge-language"></select></label>
            </div>
            <div class="input-group">
              <label>Team PIN <span class="hint" id="pin-state"></span><input id="bridge-pin" type="text" maxlength="40" autocomplete="off" placeholder="At least 4 characters" /></label>
              <button class="btn ghost" id="bridge-pin-save" type="button">Save PIN</button>
            </div>
            <p class="field-hint">On a fresh PC the Bridge app asks for this PIN, lists this team's computers, and the PC takes the chosen one's place and sheet tab.</p>
          </section>
        </div>
      </section>

      <!-- Google Drive -->
      <section data-panel="drive" class="stack hidden">
        <div class="section-head" style="margin:0">
          <div>
            <h2>Google Drive</h2>
            <p>Every night at 11:50 PM (Bangladesh time) new recordings in the connected Drive accounts are transcribed and added to Google Sheets.</p>
          </div>
          <div class="row manage-only">
            <button class="btn ghost small" id="drive-run" type="button"><Icon name="play" />Scan now</button>
            <button class="btn ghost small" id="drive-retry" type="button"><Icon name="refresh" />Retry failed</button>
            <button class="btn ghost small" id="drive-dash" type="button"><Icon name="sheet" />Update sheet dashboard</button>
          </div>
        </div>
        <div id="drive-empty" class="card hidden"></div>
        <div class="stats" id="drive-stats"></div>
        <div id="drive-computers-wrap">
          <div class="section-head"><h3>Computers</h3><span class="muted small-text" id="drive-today"></span></div>
          <div class="pc-grid" id="drive-computers"></div>
        </div>
        <div id="drive-jobs-wrap">
          <div class="section-head">
            <h3>Jobs</h3>
            <select id="job-pc" aria-label="Filter by computer" style="width:auto;min-width:180px"></select>
          </div>
          <div class="tabs" id="job-tabs" role="tablist"></div>
          <div id="job-list" class="job-list"></div>
        </div>
        <div>
          <div class="section-head">
            <h3>Connected accounts</h3>
            <a class="btn small manage-only" id="drive-connect" href={`/auth/drive?team=${encodeURIComponent(current.workspace.id)}`}><Icon name="plus" />Connect a Drive account</a>
          </div>
          <div class="stack" id="drive-accounts"></div>
        </div>
      </section>

      <!-- Transcripts -->
      <section data-panel="transcripts" class="stack hidden">
        <div class="section-head" style="margin:0">
          <div>
            <h2>Team transcripts</h2>
            <p>Everything this team's PCs and Drive accounts transcribed. They are kept here, separate from everyone's personal History.</p>
          </div>
          <form class="search" id="tx-search" style="width:min(320px,100%)">
            <Icon name="search" />
            <input type="search" name="q" placeholder="Search file names and text" aria-label="Search team transcripts" />
          </form>
        </div>
        <section class="card flush"><div class="list" id="tx-list"><p class="muted" style="padding:20px">Loading…</p></div></section>
        <button class="btn ghost hidden" id="tx-more" type="button" style="justify-self:center">Load more</button>
      </section>

      <script is:inline type="application/json" id="auto-boot" set:html={JSON.stringify(boot).replace(/</g, "\\u003c")} />
    </>
  )}
</Base>

<script>
  import { initAuto } from "../scripts/auto";
  initAuto();
</script>
