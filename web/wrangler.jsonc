{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-fahad-transcriber",
  // Astro site + the BatchRunner Durable Object (Google Drive folder batches).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Keep variables added in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "transcribe.abdullahfahad.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-fahad-transcriber",
      "database_id": "b3238cc7-d67f-4cb6-a853-c556c679e5dd",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BATCH_RUNNER", "class_name": "BatchRunner" },
      // Pinned to North America: forwards Gemini calls when Gemini refuses the server's location.
      { "name": "GEMINI_RELAY", "class_name": "GeminiRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BatchRunner"] },
    { "tag": "v2", "new_sqlite_classes": ["GeminiRelay"] }
  ],
  // Cron times are UTC. 17:50 UTC is 23:50 in Bangladesh (UTC+6): queue the day's Drive files.
  // Every 5 minutes: start queued jobs when a slot is free and retry failed videos (one cheap D1 read when idle).
  "triggers": { "crons": ["50 17 * * *", "*/5 * * * *"] },
  "vars": {
    "APP_NAME": "Team Fahad Transcriber",
    // Optional: comma separated emails allowed to use the app. Empty = any Google account.
    "ALLOWED_EMAILS": ""
  }
  // Secrets (set with `wrangler secret put`):
  //   GEMINI_API_KEYS       one or more Gemini keys, comma or newline separated
  //   GOOGLE_CLIENT_ID      Google OAuth client for login
  //   GOOGLE_CLIENT_SECRET
  // Optional, for Google Drive folder batches:
  //   NOTION_TOKEN                  Notion internal integration secret
  //   NOTION_PARENT_PAGE_ID         Notion page (link or id) that holds one page per folder
  //   GOOGLE_SERVICE_ACCOUNT_JSON   service account key file (Sheets + Drive folder listing)
  //   SHEETS_SPREADSHEET_ID         team spreadsheet (link or id), one tab per folder
  //   GOOGLE_DRIVE_API_KEY          optional extra way to list Drive folders
  // Optional, for the nightly Drive "Computers" automation (Auto page):
  //   DRIVE_COMPUTER_FOLDER_IDS     comma separated Drive folder ids to treat as computers (fallback or extras)
}
