{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "team-fahad-transcriber",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Keep variables added in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "transcribe.abdullahfahad.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-fahad-transcriber",
      "database_id": "b3238cc7-d67f-4cb6-a853-c556c679e5dd",
      "migrations_dir": "migrations"
    }
  ],
  "services": [{ "binding": "MEDIA", "service": "team-fahad-transcriber-media" }],
  "vars": {
    "APP_NAME": "Team Fahad Transcriber",
    // Optional: comma separated emails allowed to use the app. Empty = any Google account.
    "ALLOWED_EMAILS": ""
  }
  // Secrets (set with `wrangler secret put`):
  //   GEMINI_API_KEYS       one or more Gemini keys, comma or newline separated
  //   GOOGLE_CLIENT_ID      Google OAuth client for login
  //   GOOGLE_CLIENT_SECRET
}
